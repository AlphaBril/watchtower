# Copy to .env (gitignored). Values here override the shell environment.

# Fine-grained PAT on getvirtualbrain/virtual-brain:
#   Pull requests: read & write · Contents: read & write · Metadata: read
GITHUB_TOKEN=

# Claude API key for the Agent SDK (omit to use your Claude Code login)
ANTHROPIC_API_KEY=

# Claude Code binary for the SDK. On NixOS it defaults to the `claude` on PATH
# (the SDK's bundled binary can't run there); set it to pin a specific one.
WATCHTOWER_CLAUDE_PATH=
